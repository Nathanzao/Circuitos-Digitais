entity Multiplexador_VHDL is 
		port(				
				sel_1	:in bit;
				sel_0	:in bit;
				in_a	:in bit;
				in_b	:in bit;
				in_c	:in bit;
				in_d	:in bit;
				out_x	:out bit
			);
	end Multiplexador_VHDL;
	
	architecture ArquiteturaMultiplexador of Multiplexador_VHDL is
	begin
	
	out_x <= ((in_a and ( not sel_1 and not sel_0)) or (in_b and ( not sel_1 and not sel_0)) or (in_c and ( not sel_1 and not sel_0)) or (in_d and ( not sel_1 and not sel_0)));
	
	end ArquiteturaMultiplexador;